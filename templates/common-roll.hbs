<div class="message-container">
  {{#if message}}
  <div class="message-content-wrapper">
    <div class="message-header">
      <span class="message-sender">{{message.user}}</span>
    </div>
    <div class="message-content">
      {{{message.content}}}
    </div>
  </div>
  {{/if}}
  
  {{#if roll}}
  <div class="sc-dice-result-wrapper">
    <p class="roll-formula">{{roll.formula}}</p>

    <div class="sc-dice-results">
      {{#each roll.terms as |term|}}
        {{#each term.results as |result|}}
          <div class="sc-dice-result dice-{{term.faces}}">
            <span class="dice-number {{result.class}}">{{result.value}}</span>
          </div>
        {{/each}}
      {{/each}}
    </div>

    {{#if roll.total}}
      <p class="sc-roll-total">{{roll.total}}</p>
    {{/if}}
  </div>
  {{/if}}
</div>